ARG AGENT_BASE_IMAGE=ghcr.io/kubeopencode/kubeopencode-agent-devbox@sha256:f2b6a3d814bee7a41bca1380f45f61410f8e9e2d29ce363fb8883fc95ce10e0f

FROM rust:1.91-alpine3.22 AS rtk
ARG RTK_COMMIT=4ef8730cf3a0dea11c8d64a9b90bc0616fe52100
RUN apk add --no-cache git musl-dev && \
    cargo install --git https://github.com/rtk-ai/rtk --rev "${RTK_COMMIT}" --locked --root /opt/rtk rtk && \
    /opt/rtk/bin/rtk --version

FROM ${AGENT_BASE_IMAGE}
USER 0:0
COPY --from=rtk /opt/rtk/bin/rtk /usr/local/bin/rtk
USER 1000:0
