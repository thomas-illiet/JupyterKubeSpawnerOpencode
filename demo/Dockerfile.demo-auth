FROM golang:1.24.7-alpine@sha256:fc2cff6625f3c1c92e6c85938ac5bd09034ad0d4bc2dfb08278020b68540dbb5 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/demo-auth ./cmd/demo-auth
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/demo-auth ./cmd/demo-auth

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/demo-auth /demo-auth
USER 65532:65532
ENTRYPOINT ["/demo-auth"]

