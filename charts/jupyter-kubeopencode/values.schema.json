{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Jupyter KubeOpenCode Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "mediator", "cleanup", "agent", "registries", "workspaces", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "mediator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "jupyterHubUserURL", "kubeOpenCodeServerURL", "snapshotImage", "taskTimeout", "reconcileInterval", "resources"],
      "properties": {
        "namespace": { "$ref": "#/$defs/dnsLabel" },
        "jupyterHubUserURL": { "type": "string", "pattern": "^https?://" },
        "kubeOpenCodeServerURL": { "type": "string", "pattern": "^https?://" },
        "snapshotImage": { "type": "string", "minLength": 1 },
        "taskTimeout": { "$ref": "#/$defs/duration" },
        "reconcileInterval": { "$ref": "#/$defs/duration" },
        "resources": { "type": "object" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuRequest", "cpuLimit", "memoryRequest", "memoryLimit", "ephemeralStorageLimit"],
      "properties": {
        "cpuRequest": { "type": "string", "minLength": 1 },
        "cpuLimit": { "type": "string", "minLength": 1 },
        "memoryRequest": { "type": "string", "minLength": 1 },
        "memoryLimit": { "type": "string", "minLength": 1 },
        "ephemeralStorageLimit": { "type": "string", "minLength": 1 }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingSecret", "tokenKey"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "tokenKey": { "type": "string", "minLength": 1 }
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workspace" }
    },
    "registries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registry" }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "modelGatewayNamespaceLabel", "jupyterHubNamespaceLabel", "kubeOpenCodeNamespaceLabel", "dnsNamespaceLabel", "apiServerCIDR"],
      "properties": {
        "enabled": { "type": "boolean" },
        "modelGatewayNamespaceLabel": { "$ref": "#/$defs/dnsLabel" },
        "jupyterHubNamespaceLabel": { "$ref": "#/$defs/dnsLabel" },
        "kubeOpenCodeNamespaceLabel": { "$ref": "#/$defs/dnsLabel" },
        "dnsNamespaceLabel": { "$ref": "#/$defs/dnsLabel" },
        "apiServerCIDR": { "type": "string", "pattern": "^$|^[0-9a-fA-F:.]+/[0-9]{1,3}$" }
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h)$"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "namespace", "pvc", "subPath", "snapshotPvc", "registry", "requiredSkills"],
      "anyOf": [
        { "required": ["modelSecret", "modelSecretKey", "modelEnvironment"] },
        { "required": ["openCodeBaseUrl", "openCodeModel"] }
      ],
      "properties": {
        "id": { "type": "string", "maxLength": 50, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "owner": { "type": "string", "minLength": 1, "maxLength": 253 },
        "namespace": { "$ref": "#/$defs/dnsLabel" },
        "pvc": { "$ref": "#/$defs/dnsLabel" },
        "subPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]",
          "not": { "pattern": "\\.\\." }
        },
        "snapshotPvc": { "$ref": "#/$defs/dnsLabel" },
        "modelSecret": { "$ref": "#/$defs/dnsLabel" },
        "modelSecretKey": { "type": "string", "minLength": 1 },
        "modelEnvironment": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
        "openCodeBaseUrl": { "type": "string", "pattern": "^https?://" },
        "openCodeModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "allowedModels": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "uniqueItems": true },
        "modelProxyUrl": { "type": "string", "pattern": "^https?://" },
        "runtimeClassName": { "type": "string" },
        "executorImage": { "type": "string" },
        "agentImage": { "type": "string" },
        "attachImage": { "type": "string" },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 }
        ,"registry": { "$ref": "#/$defs/dnsLabel" }
        ,"requiredSkills": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/dnsLabel" } }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "checkInterval", "skills", "plugins"],
      "properties": {
        "name": { "$ref": "#/$defs/dnsLabel" },
        "namespace": { "$ref": "#/$defs/dnsLabel" },
        "checkInterval": { "$ref": "#/$defs/duration" },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "git"],
            "properties": {
              "name": { "$ref": "#/$defs/dnsLabel" },
              "git": {
                "type": "object", "additionalProperties": false, "required": ["repository"],
                "properties": {
                  "repository": { "type": "string", "minLength": 1 }, "ref": { "type": "string" }, "path": { "type": "string" },
                  "names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                  "depth": { "type": "integer", "minimum": 0 }, "recurseSubmodules": { "type": "boolean" },
                  "secretRef": { "type": "object" }
                }
              },
              "metadata": { "$ref": "#/$defs/assetMetadata" }
            }
          }
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "plugin"],
            "properties": {
              "name": { "$ref": "#/$defs/dnsLabel" },
              "plugin": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "target": { "enum": ["server", "tui"] } } },
              "metadata": { "$ref": "#/$defs/assetMetadata" }
            }
          }
        }
      }
    },
    "assetMetadata": {
      "type": "object", "additionalProperties": false,
      "properties": { "description": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "requiredCredentials": { "type": "array", "items": { "type": "object" } } }
    }
  }
}
